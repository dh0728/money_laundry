FROM python:3.13-slim-trixie
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /workspace/backend/api-server/demo
COPY api-server/demo/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home app
COPY api-server/demo /workspace/backend/api-server/demo
COPY bank-mock/bank_mock.py /workspace/backend/bank-mock/bank_mock.py
USER app:app
ENTRYPOINT ["python", "-B", "runtime.py", "ui"]
