+  const remain = episode.alerts.length - picked.length
+
+  return <div className="space-y-4" data-testid="overview">
+    <CaseStats items={[
+      { label: '외부 유입액', value: usd(externalIn), secondary: '사건 밖에서 들어온 돈' },
