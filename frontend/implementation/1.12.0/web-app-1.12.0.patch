+    const g = buildTimeline([own('A1', 'B1', 9, '갑', '을'), own('B1', 'A2', 10, '을', '갑'), own('A2', 'C1', 11, '갑', '병')])
+    const plan = lanePlan(g, 'owner')
+    expect(plan.groups.map(x => [x.name, x.accounts])).toEqual([['갑', ['A1', 'A2']], ['을', ['B1']], ['병', ['C1']]])
+    for (const lane of [76, 124]) {
