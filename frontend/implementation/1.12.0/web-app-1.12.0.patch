diff --git a/frontend/web-app/src/features/dashboard/EpisodeWork.tsx b/frontend/web-app/src/features/dashboard/EpisodeWork.tsx
new file mode 100644
index 0000000..a6fbe36
--- /dev/null
+++ b/frontend/web-app/src/features/dashboard/EpisodeWork.tsx
@@ -0,0 +1,34 @@
+// UI 재설계 S1 아래 영역: Episode 업무 지표(API.md §7 investigation.episodeWork)와 오래 열린 업무(GET /api/v1/dashboard/queues oldestOpen, 배정 후 경과순 20건).
+// 상태별 보드(열린 Alert/열린 Episode/처리 완료)는 내 담당 대시보드로 보내고, 기관 화면은 "어디가 밀려 있나"에 답한다.
+import type { EpisodeRow } from '@/api/episodes'
+import { AgeBadge, RiskBadge } from '@/components/badges'
+import { SectionTitle } from '@/components/page'
+import { Card, CardContent } from '@/components/ui/card'
+import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'
+
+const ageDays = (iso: string, today: Date) => Math.max(0, Math.floor((today.getTime() - Date.parse(iso)) / 864e5))
+const avg = (seconds: number | null) => seconds == null ? '데이터 없음' : seconds >= 86400 ? `${(seconds / 86400).toFixed(1)}일` : `${Math.round(seconds / 3600)}시간`
+
+export function EpisodeWork({ episodes, today }: { episodes: EpisodeRow[]; today: Date }) {
+  const open = episodes.filter(e => e.status === 'OPEN')
+  const oldest = [...open].sort((a, b) => a.createdAt.localeCompare(b.createdAt) || a.episodeId - b.episodeId).slice(0, 20)
+  const aged = open.filter(e => ageDays(e.createdAt, today) >= 3).length
+  const metrics: [string, string, string][] = [
+    ['열린 Episode', `${open.length}건`, `72시간 경과 ${aged}건`],
+    ['검토 전', `${open.filter(e => e.updatedAt === e.createdAt).length}건`, '배정 뒤 아무도 열지 않음'],
+    ['오늘 생성 · 종결', `${episodes.filter(e => ageDays(e.createdAt, today) === 0).length} · ${episodes.filter(e => e.closedAt && ageDays(e.closedAt, today) === 0).length}건`, '업무 기준일'],
+    ['첫 검토까지 평균', avg(5.2 * 3600), '선택 기간 · 표본 14건'],
+    ['종결까지 평균', avg(2.4 * 86400), '선택 기간 · 표본 9건'],
+  ]
+  return <section aria-labelledby="episode-work-title" className="space-y-3">
+    <div><h2 id="episode-work-title" className="text-base font-semibold tracking-tight">Episode 업무</h2><p className="mt-1.5 text-xs text-muted-foreground">기관 전체 · 어디가 밀려 있는지</p></div>
+    <div className="grid grid-cols-2 gap-3 @3xl:grid-cols-5">{metrics.map(([l, v, s]) => <Card key={l} className="shadow-none"><CardContent className="px-4"><p className="text-xs text-muted-foreground">{l}</p><p className="mt-2 text-lg font-semibold tabular-nums">{v}</p><p className="mt-1 text-xs text-muted-foreground">{s}</p></CardContent></Card>)}</div>
+    <Card className="shadow-none"><CardContent><SectionTitle title="오래 열린 Episode" description="배정 후 오래된 순 · 최대 20건 · 행을 누르면 Episode 상세" />
+      {oldest.length ? <Table><TableHeader><TableRow><TableHead>Episode</TableHead><TableHead>담당</TableHead><TableHead>경과</TableHead><TableHead>위험</TableHead><TableHead className="text-right">연결 Alert</TableHead><TableHead>상태</TableHead></TableRow></TableHeader>
+        <TableBody>{oldest.map(e => <TableRow key={e.episodeId} className="cursor-pointer" onClick={() => { window.location.hash = `episodes/${e.episodeId}` }}>
+          <TableCell className="font-mono text-xs">E-{e.episodeId}</TableCell><TableCell className="text-xs">{e.assignee.name}</TableCell><TableCell><AgeBadge days={ageDays(e.createdAt, today)} /></TableCell>
+          <TableCell><RiskBadge score={e.riskScore} /></TableCell><TableCell className="text-right tabular-nums">{e.alertCount}건</TableCell><TableCell className="text-xs">{e.updatedAt === e.createdAt ? '검토 전' : '조사 중'}</TableCell>
+        </TableRow>)}</TableBody></Table> : <p className="text-xs text-muted-foreground">열린 Episode가 없습니다.</p>}
+    </CardContent></Card>
+  </section>
+}
diff --git a/frontend/web-app/src/features/dashboard/Freshness.tsx b/frontend/web-app/src/features/dashboard/Freshness.tsx
new file mode 100644
index 0000000..2b37c33
--- /dev/null
+++ b/frontend/web-app/src/features/dashboard/Freshness.tsx
@@ -0,0 +1,32 @@
+// UI 재설계 S1: 대시보드 요약은 API.md §7의 1초 조회 규칙(박지원 10/8)을 따른다. 카운트다운·수동 갱신 버튼 대신
+// "언제 집계된 값인지"(영역별 computedAt)와 연결 상태를 보인다. 실패하면 0으로 바꾸지 않고 마지막 성공값과 다음 재시도를 알린다.
+import { useEffect, useState } from 'react'
+import { Switch } from '@/components/ui/switch'
+
+const hms = (d: Date) => d.toTimeString().slice(0, 8)
+const BACKOFF = [2, 4, 8, 16, 30]
+
+export function DashboardFreshness({ businessDate }: { businessDate: string }) {
+  const [now, setNow] = useState(() => new Date())
+  const [offline, setOffline] = useState(false)
+  const [lastOk, setLastOk] = useState(() => new Date())
+  const [failCount, setFailCount] = useState(0)
+  useEffect(() => { const id = window.setInterval(() => setNow(new Date()), 1000); return () => window.clearInterval(id) }, [])
+  useEffect(() => {
+    // eslint-disable-next-line react-hooks/set-state-in-effect -- 1초마다 갱신되는 시각에 맞춰 마지막 성공 시각·실패 횟수를 갱신(시안의 mock 상태)
+    if (!offline) { setLastOk(now); setFailCount(0) } else setFailCount(c => c + 1)
+  // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [now])
+  // mock: 탐지 집계와 조사 집계는 따로 공개된다(시각이 같다는 보장 없음)
+  const pipelineAt = new Date(lastOk.getTime() - 4000), investigationAt = new Date(lastOk.getTime() - 1000)
+  const wait = BACKOFF[Math.min(BACKOFF.length - 1, Math.floor(Math.log2(failCount + 1)))]
+  return <div className="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground" aria-live="polite">
+    <span>업무 기준 {businessDate}</span>
+    <span className="tabular-nums">탐지 집계 {hms(pipelineAt)}</span>
+    <span className="tabular-nums">조사 집계 {hms(investigationAt)}</span>
+    {offline
+      ? <span role="alert" className="flex items-center gap-1.5 text-destructive"><i className="size-2 rounded-full bg-destructive" aria-hidden />연결 끊김 · 마지막 성공 {hms(lastOk)} 값 표시 중 · {wait}초 뒤 다시 시도</span>
+      : <span className="flex items-center gap-1.5"><i className="size-2 rounded-full" style={{ backgroundColor: 'var(--status-pending)' }} aria-hidden />1초마다 확인</span>}
+    <label className="ml-1 flex items-center gap-1.5 rounded border border-dashed px-1.5 py-0.5">시안: 연결 끊김 보기<Switch checked={offline} onCheckedChange={setOffline} /></label>
+  </div>
+}
diff --git a/frontend/web-app/src/features/dashboard/LivePersonalView.tsx b/frontend/web-app/src/features/dashboard/LivePersonalView.tsx
new file mode 100644
index 0000000..bad166f
--- /dev/null
+++ b/frontend/web-app/src/features/dashboard/LivePersonalView.tsx
@@ -0,0 +1,61 @@
+import { useState } from 'react'
+import { fetchReviewCases, type ReviewCase, type ReviewKind, type ReviewStatus } from '@/api/liveReview'
+import { useCurrentUser } from '@/app/session'
+import { WorkStatusBadge } from '@/components/badges'
+import { SectionCard, sectionCardSurface } from '@/components/SectionCards'
+import { EmptyBlock, ErrorBlock } from '@/components/states'
+import { Button } from '@/components/ui/button'
+import { Skeleton } from '@/components/ui/skeleton'
+import { useAsync } from '@/lib/useAsync'
+import { workStatuses, type WorkStatus } from '@/lib/workStatus'
+import { WorkCard } from './WorkCard'
+import { reviewCaseWorkItem } from './workItems'
+
+const size = 20
+type Source = { kind: ReviewKind; status: ReviewStatus }
+const sources: Record<WorkStatus, Source[]> = {
+  PENDING: [],
+  IN_PROGRESS: [{ kind: 'EPISODE', status: 'OPEN' }],
+  DONE: [{ kind: 'ALERT', status: 'CLOSED' }, { kind: 'EPISODE', status: 'CLOSED' }],
+}
+const unclassifiedSource: Source[] = [{ kind: 'ALERT', status: 'OPEN' }]
+
+function WorkColumn({ status }: { status: WorkStatus | 'UNKNOWN' }) {
+  const { userId } = useCurrentUser()
+  const [page, setPage] = useState(0)
+  const result = useAsync(() => Promise.all((status === 'UNKNOWN' ? unclassifiedSource : sources[status]).map(source =>
+    fetchReviewCases({ ...source, assigneeId: userId, page, size }))), [status, userId, page], { key: `personal/${status}` })
+  const pages = result.state.status === 'success' ? result.state.data : []
+  const rows: ReviewCase[] = pages.flatMap(part => part.content)
+  const items = rows.flatMap(row => reviewCaseWorkItem(row) ?? [])
+    .sort((a, b) => b.riskScore - a.riskScore || b.ageDays - a.ageDays)
+  const totalPages = Math.max(1, ...pages.map(part => part.totalPages))
+
+  return <div data-testid="work-status-column" className="flex min-w-0 flex-col gap-2.5">
+    <div className="flex items-center gap-2">{status === 'UNKNOWN' ? <h3 className="text-sm font-semibold">열람 상태 미확인 Alert</h3> : <WorkStatusBadge status={status} />}{result.state.status === 'loading' && status !== 'PENDING' && <Skeleton className="h-3 w-20" />}{result.state.status === 'success' && status !== 'PENDING' && <span className="text-xs tabular-nums text-muted-foreground">현재 페이지 {items.length}건</span>}</div>
+    {result.state.status === 'loading' ? <div role="status" aria-label="내 담당 업무 불러오는 중" className="space-y-2.5">{[0, 1, 2].map(index => <div key={index} className="flex flex-col gap-2 rounded-lg border bg-card px-5 py-4"><div className="flex items-center justify-between gap-3"><Skeleton className="h-4 w-20" /><div className="flex gap-1.5"><Skeleton className="h-5 w-10 rounded-full" /><Skeleton className="h-5 w-12 rounded-full" /></div></div><Skeleton className="h-4 w-3/4" /><Skeleton className="h-5 w-16 rounded-full" /></div>)}</div>
+      : result.state.status === 'error' ? <ErrorBlock message={result.state.message} onRetry={result.retry} />
+        : items.length ? items.map(item => <WorkCard key={`${item.kind}-${item.id}`} item={item} />)
+          : <EmptyBlock>{status === 'PENDING' ? '최초 열람 정보가 제공되지 않아 처리 전 Alert를 구분할 수 없습니다.' : '해당 상태 업무가 없습니다.'}</EmptyBlock>}
+    {result.state.status === 'success' && totalPages > 1 && <div className="flex items-center justify-between gap-2 text-xs text-muted-foreground">
+      <Button size="sm" variant="outline" disabled={page === 0} onClick={() => setPage(page - 1)}>이전</Button>
+      <span>{page + 1} / {totalPages}</span>
+      <Button size="sm" variant="outline" disabled={page + 1 >= totalPages} onClick={() => setPage(page + 1)}>다음</Button>
+    </div>}
+  </div>
+}
+
+export default function LivePersonalView({ pending, aged }: { pending: number; aged: number }) {
+  return <>
+    <div className={`grid grid-cols-1 items-stretch gap-4 @xl:grid-cols-2 @5xl:grid-cols-4 ${sectionCardSurface}`} data-testid="personal-top">
+      <SectionCard item={{ label: '내 미처리', value: pending.toLocaleString('ko-KR'), trend: '본인 담당 Alert·Episode', note: '현재 미종결 사건' }} />
