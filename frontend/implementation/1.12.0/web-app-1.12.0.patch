+    const g = buildTimeline([t('A', 'B', 9), t('B', 'C', 9)])
+    expect(g.apps.filter(a => a.account === 'B')).toHaveLength(1)
+    expect(g.bundles.find(b => b.source.startsWith('B'))!.sameTime).toBe(true)
+    expect(g.violations).toBe(0)
