+const STAGES = [['WAIT_INGEST', '수신 대기'], ['INTEGRATE', '통합'], ['FREEZE_INPUT', '입력 고정'], ['FEATURES', '피처'], ['INFERENCE', '추론'], ['SCORES', '점수'], ['ALERTS', 'Alert 생성'], ['COMPLETE', '완료']] as const
