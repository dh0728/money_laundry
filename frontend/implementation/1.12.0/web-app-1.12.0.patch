+    const ping = buildTimeline(Array.from({ length: 20 }, (_, i) => i % 2 ? t('Y', 'X', i) : t('X', 'Y', i)))
+    expect(ping.apps.filter(a => a.account === 'X').length).toBeLessThanOrEqual(5)
+    expect(ping.violations).toBe(0)
