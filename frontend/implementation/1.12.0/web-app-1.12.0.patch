+  it('끊긴 두 덩어리와 하루 넘는 간격', () => {
+    const rows = [t('A', 'B', 9), { ...t('C', 'D', 9), txAt: '2026-09-23T09:00:00+09:00' }]
+    const g = buildTimeline(rows)
+    expect(g.gaps).toEqual([{ afterIndex: 0, days: 3 }])
