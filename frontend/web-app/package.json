{
  "name": "web-app",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:design": "node scripts/design-report.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --ci --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "tokens:sync": "node scripts/sync-v3-tokens.mjs",
    "tokens:preview:sync": "node scripts/sync-preview-figma-colors.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('lefthook install',{stdio:'ignore'})}catch{}\""
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "12.12.0",
    "antd": "6.6.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-sankey": "0.12.3",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "date-fns": "^4.4.0",
    "dayjs": "1.11.11",
    "elkjs": "^0.12.0",
    "lucide-react": "^0.577.0",
    "motion": "12.23.12",
    "nuqs": "^2.10.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-resizable-panels": "^4.14.1",
    "react-rnd": "^10.5.3",
    "react-zoom-pan-pinch": "^4.2.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lefthook": "2.2.2",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "storybook": "10.6.7",
    "stylelint": "18.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
