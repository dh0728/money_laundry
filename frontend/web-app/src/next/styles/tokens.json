  "curve": {
    "coordinate": "OKLCH L; 8-bit sRGB output",
    "L": [
      0.12,
      0.16,
      0.22,
      0.31,
      0.43,
      0.5519134131875348,
      0.69,
      0.81,
      0.9,
      0.95,
      0.985
    ],
    "implementation": "fixed hue, bell-shaped chroma, reduce chroma to sRGB gamut; quantize once",
    "codeTones": [
      "005",
      "010",
      "020",
      "030",
      "040",
      "050",
      "060",
      "070",
      "080",
      "090",
      "095"
    ],
    "naming": "Ordinal lightness order, 000 black to 100 white. Hue stops005..095 are not literal HSB B or OKLCH L percentages. Black/White suffixes instead specify opacity."
